<?xml version="1.0" encoding="UTF-8"?>
<!--
  电子科技大学电信校园网自动登录 —— 计划任务模板

  推荐运行 install_task.ps1：自动探测 Python 3.10+、检查 requests、填写路径并导入。
  此 XML 仅供手动导入，必须替换所有对应值：
    YOUR-PC\YOUR-USERNAME -> 当前 Windows 用户
    C:\AutoLogin-uestc -> 项目目录（可以含空格）
    C:\Path\To\Python\python.exe -> 已安装 requests 的真实解释器
  Python 可以来自系统安装或虚拟环境，不强制使用 .venv。
  路径如含 &，请在 XML 文本中写为 &amp;；安装脚本会自动处理转义。
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>YOUR-PC\YOUR-USERNAME</Author>
    <Description>UESTC 电信校园网自动登录：登录 / 解锁 / 唤醒后抢网，并关闭认证页</Description>
    <URI>\UESTC-Portal</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>YOUR-PC\YOUR-USERNAME</UserId>
    </LogonTrigger>
    <SessionStateChangeTrigger>
      <Enabled>true</Enabled>
      <StateChange>SessionUnlock</StateChange>
      <UserId>YOUR-PC\YOUR-USERNAME</UserId>
    </SessionStateChangeTrigger>
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="System"&gt;&lt;Select Path="System"&gt;*[System[Provider[@Name='Microsoft-Windows-Kernel-Power'] and EventID=107]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
      <Delay>PT2S</Delay>
    </EventTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>YOUR-PC\YOUR-USERNAME</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\wscript.exe</Command>
      <Arguments>"C:\AutoLogin-uestc\run_hidden.vbs" "C:\Path\To\Python\python.exe"</Arguments>
      <WorkingDirectory>C:\AutoLogin-uestc</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
